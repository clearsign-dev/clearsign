<?xml version="1.0" encoding="UTF-8"?>
<!--
  Three things on the seL4 microkernel:
    VMM      runs a Linux guest (untrusted: apps, network in future, anything)
    signer   reviews transactions for the guest; trusted, tiny, no devices
  Every permission is in this file. Linux sees the request region read-write,
  the review region READ-ONLY, and a doorbell page that traps to the VMM.

  Linux has NO serial device. It used to have the real one mapped read-write,
  which let the untrusted side write to the same console the signer reports on —
  so a compromised guest could print a clean review of a transaction the signer
  had called CRITICAL. Its writes to 0x9000000 now trap to the VMM, which relays
  them behind a "GUEST|" prefix. Lines beginning "SIGNER|" can only come from the
  signer.
-->
<system>
    <memory_region name="guest_ram" size="0x10_000_000" />
    <memory_region name="serial" size="0x1_000" phys_addr="0x9000000" />
    <memory_region name="gic_vcpu" size="0x1_000" phys_addr="0x8040000" />
    <memory_region name="signer_request" size="0x10_000" />
    <memory_region name="signer_review" size="0x10_000" />

    <protection_domain name="VMM" priority="254">
        <program_image path="vmm.elf" />
        <map mr="serial" vaddr="0x9000000" perms="rw" cached="false" />
        <map mr="guest_ram" vaddr="0x40000000" perms="rw" setvar_vaddr="guest_ram_vaddr" />
        <virtual_machine name="linux">
            <vcpu id="0" />
            <map mr="guest_ram" vaddr="0x40000000" perms="rwx" />
            <map mr="gic_vcpu" vaddr="0x8010000" perms="rw" cached="false" />
            <map mr="signer_request" vaddr="0x60000000" perms="rw" />
            <map mr="signer_review" vaddr="0x60100000" perms="r" />
            <!-- 0x60200000 is deliberately unmapped: writes there trap to the VMM (doorbell). -->
        </virtual_machine>
        <irq irq="33" id="1" />
    </protection_domain>

    <protection_domain name="signer" priority="200" stack_size="0x40000">
        <program_image path="signer.elf" />
        <map mr="signer_request" vaddr="0x4000000" perms="r" setvar_vaddr="request_vaddr" />
        <map mr="signer_review" vaddr="0x4100000" perms="rw" setvar_vaddr="review_vaddr" />
    </protection_domain>

    <channel>
        <end pd="VMM" id="2" />
        <end pd="signer" id="1" />
    </channel>
</system>
