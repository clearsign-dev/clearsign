# Single source of truth for every borrowed component: exact versions, hashes and
# signing-key fingerprints. Every fetch and build script reads this file.
#
# Format: shell-compatible KEY=VALUE, no spaces around '=', no quotes needed.
# Changing a pin is a security decision: update the value AND the "verified" note.
#
# Trust levels used in the notes:
#   pinned-independent  key confirmed through a second, independent channel
#   pinned-tofu         key pinned on first use; no second channel was available
#   hash-only           no signature exists; only the file's SHA-256 is pinned

# ---- seL4 Microkit SDK (kernel and protection-domain framework) ----
MICROKIT_VERSION=2.3.0
MICROKIT_SDK_ASSET=microkit-sdk-2.3.0-macos-aarch64.tar.gz
MICROKIT_SDK_SHA256=f688ca8cc3545ee95681c509efc00cf212f79b75d919a9639371fff8fa51dc20
# pinned-tofu, 2026-09-16: signed by Julia Vassiliki <julia.vassiliki@unsw.edu.au>, key from
# keys.openpgp.org. The publishing GitHub account has no GPG keys and the git tag is unsigned.
MICROKIT_SIGNING_KEY_FPR=FE91486443B0F4EB9ECC36524D868A34EDF3FDCA

# ---- libvmm (virtual machine monitor for Linux guests on seL4) ----
LIBVMM_TAG=0.2.0
LIBVMM_COMMIT=7069ab99d25d3e05783b8b3fbd68fde2a1b6cf4e
SDDF_COMMIT=a15355c7ce65ed94e91716ec348b8273188ecf16

# ---- Linux guest images: PREBUILT FALLBACK ONLY (GUEST=prebuilt) ----
# hash-only, 2026-09-16: prebuilt by a third party, hosted by Trustworthy Systems, unsigned.
# The default guest is built from source; see the section below.
GUEST_IMAGE_BASE_URL=https://trustworthy.systems/Downloads/libvmm/images
GUEST_LINUX_NAME=8b1d3a8587c60428c79d3e1981e7b6a7c653e1f8-linux
GUEST_LINUX_SHA256=97f5cdc699429928315b29b1f593849db0bd05bbce92901eddfd402ae8a4bb7a
GUEST_INITRD_NAME=e800d52939b73281670df8598cb9c616dfd44f10-rootfs.cpio.gz
GUEST_INITRD_SHA256=4fe7456925c778497f918ae43f0ac7bcf6b466a3a8d49ab5f4ce256ac10f530d

# ---- Linux guest built from source (replaces the hash-only prebuilt images) ----
GUEST_KERNEL_VERSION=6.18.52
GUEST_KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x
GUEST_KERNEL_TARBALL_SHA256=2b69564f7d4fea0c859b1959ba33709ee6e9139bd100e30a853b57159a8221b8
# pinned-independent, 2026-09-16: Greg Kroah-Hartman's key fetched from kernel.org's own Web Key
# Directory, matching his long-published fingerprint. Signature verified over the uncompressed tar.
GUEST_KERNEL_SIGNING_KEY_FPR=647F28654894E3BD457199BE38DBBDC86092693E
# Userland (BusyBox, glibc) comes from Debian packages inside DEBIAN_BUILD_IMAGE, verified by apt.

# ---- GrapheneOS ----
GRAPHENEOS_RELEASE=2026091000
# pinned-tofu, 2026-09-16: from grapheneos.org/allowed_signers; matches the key GrapheneOS
# documents for tag verification. Tag signature verified against it.
GRAPHENEOS_SSH_KEY_FP=SHA256:AhgHif0mei+9aNyKLfMZBh2yptHdw/aN7Tlh/j2eFwM
# The hardened_malloc commit is NOT pinned here: it is read from the verified manifest.

# ---- Alpine Linux (development VM) ----
ALPINE_VERSION=3.24.1
# pinned-independent, 2026-09-16: fingerprint matched both alpinelinux.org/keys/ncopa.asc
# and the fingerprint printed on alpinelinux.org/downloads.
ALPINE_SIGNING_KEY_FPR=0482D84022F52DF1C4E7CD43293ACD0907D9495A

# ---- Build containers ----
# Pinned by digest so the Linux build environment cannot change underneath us.
DEBIAN_BUILD_IMAGE=debian:trixie@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1

# ---- Rust ----
# The toolchain is pinned in signing-core/rust-toolchain.toml (1.98.1); dependencies in Cargo.lock.
